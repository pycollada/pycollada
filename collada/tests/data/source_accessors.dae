  </asset>
  <library_geometries>
    <geometry id="triangle" name="AccessorTriangle">
      <mesh>
        <source id="positions">
          <float_array id="positions-array" count="18">99 0 77 0 0 88 1 77 0 0 88 0 77 1 0 88 99 99</float_array>
          <technique_common>
